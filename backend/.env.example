# Application Settings
PROJECT_NAME="AI Research Paper Assistant"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Database
DATABASE_URL="sqlite:///./storage/research.db"

# Storage Configuration
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=50

# Text Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embedding Configuration
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Vector Search
TOP_K_RETRIEVAL=5

# LLM Provider Configuration ("ollama" or "openai")
LLM_PROVIDER="ollama"

# Ollama Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# OpenAI Settings (optional, only used if LLM_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

